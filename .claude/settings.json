{
  "hooks": {
    "PostToolUse": [
      {
        "matcher": "Bash",
        "hooks": [
          {
            "type": "command",
            "command": "bash .claude/hooks/npm-audit-check.sh",
            "timeout": 30,
            "statusMessage": "Checking for vulnerable packages..."
          }
        ]
      }
    ]
  }
}
